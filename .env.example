PORT=3001
CLIENT_ORIGIN=http://localhost:5173
VITE_CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=./kasyr.db

# Auth / cookies
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me

# Frontend config
VITE_API_URL=http://localhost:3001
VITE_USE_MOCK=false
VITE_SUPPORT_TELEGRAM_URL=https://t.me/YOUR_SUPPORT_USERNAME
VITE_SHOW_SUBSCRIPTION_UI=false
VITE_SHOW_HINTS=true

# Local dev convenience
SKIP_EMAIL_VERIFICATION=true

# AI (Grok / xAI)
GROK_API_KEY=
# Model id expected by xAI API (lowercase)
GROK_MODEL=grok-4-1-fast-non-reasoning
# Daily per-user limit for paid AI calls (chat + classification). Recommended: 10-20.
AI_DAILY_LIMIT=20

