# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
VITE_CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=
DATABASE_URL=./kasyr.db

# Authentication — replace with long, unique values outside local development
JWT_SECRET=change-me
COOKIE_SECRET=change-me
JWT_EXPIRES_IN=7d
SKIP_EMAIL_VERIFICATION=true

# Frontend feature flags
VITE_USE_MOCK=false
VITE_SHOW_HINTS=true
VITE_SHOW_SUBSCRIPTION_UI=false
VITE_SUPPORT_TELEGRAM_URL=

# Optional AI classification and help
GROK_API_KEY=
GROK_MODEL=grok-3-mini
AI_DAILY_LIMIT=10

# Optional email provider: Resend or SMTP
RESEND_API_KEY=
EMAIL_FROM=Kasyr.ai <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Optional Telegram reminders
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional WayForPay checkout
WAYFORPAY_MERCHANT_LOGIN=
WAYFORPAY_SECRET_KEY=
API_URL=http://localhost:3001

# Seed script: true deletes all local rows before seeding; use with care
SEED_FRESH=false

